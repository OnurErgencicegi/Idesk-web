# Sunucu
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Kimlik doğrulama
JWT_SECRET=cok-gizli-uzun-bir-anahtar-buraya

# ÖDEAL Merchant bilgileri (ÖDEAL Merchant Panel > API Ayarları'ndan alın)
# Gerçek anahtarlarınızı asla frontend koduna veya git'e koymayın, sadece bu .env dosyasında tutun.
ODEAL_API_BASE=https://api.odeal.com
ODEAL_API_KEY=odeal-live-veya-test-api-key
ODEAL_MERCHANT_ID=odeal-merchant-id
ODEAL_TERMINAL_ID=odeal-terminal-id
ODEAL_CALLBACK_URL=https://sizin-domaininiz.com/api/payment/odeal/callback
ODEAL_SUCCESS_REDIRECT=https://sizin-domaininiz.com/odeme-basarili
ODEAL_FAIL_REDIRECT=https://sizin-domaininiz.com/odeme-basarisiz

# SMTP (Şifremi Unuttum e-postaları için — idesk.com.tr'nizin mail sağlayıcısından alın)
# cPanel/DirectAdmin gibi bir panelden domain postası açtıysanız genelde
# host: mail.idesk.com.tr, port: 465 (SSL) veya 587 (STARTTLS) olur.
SMTP_HOST=mail.idesk.com.tr
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=destek@idesk.com.tr
SMTP_PASS=posta-kutusu-sifreniz
SMTP_FROM="Idesk <destek@idesk.com.tr>"

# Şifre sıfırlama linkinin yönlendireceği frontend adresi
FRONTEND_BASE_URL=https://www.idesk.com.tr
